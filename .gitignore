# Python environments and caches
.venv
venv
__pycache__/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store

# Training outputs at the project root (phases/<phase>/runs/ are kept)
/runs/

# Older nested Booster layout (still supported by scripts/setup_booster.sh)
booster/
# Booster repos or compatibility links at the project root
booster_*/
/booster_assets
/booster_deploy

# ROS workspaces and local Docker setup (from PR #5; was `*ros*`, which also matched
# unrelated names, so narrowed to folders starting with "ros")
ros*/
Dockerfile

# Local secrets (robot password etc.): never commit them
credentials*.md
*.pdf

# mjlab training runs (checkpoints, exported ONNX, TensorBoard) and MuJoCo warnings
logs/
MUJOCO_LOG.TXT


.ruff_cache
uv run ruff check . && uv run ruff format --check && uv run pytest
# graphify knowledge graph output (rebuild locally with `graphify update .`)
graphify-out/
# Personal Claude Code settings (graphify hooks point to each person's own install)
.claude/settings.local.json

# Local secrets (robot password etc.): never commit them
credentials*.md
!credentials.example.md
# Handover PDF contains the robot password; share it directly, not via git
handover docs/*.pdf