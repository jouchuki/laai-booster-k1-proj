# Python environments and caches
.venv
.venv.nosync
venv
__pycache__/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store

# Training output: checkpoints, TensorBoard, videos (logs/<experiment>/<date>_<run-name>/),
# W&B local files and MuJoCo warnings. The curated record of each run is kept in
# experiments/<experiment>/runs/runN/.
logs/
/runs/
wandb/
MUJOCO_LOG.TXT

# Booster's code, cloned by scripts/setup_booster.sh: at the project root, or in the
# older nested booster/ folder (root links then point into it)
booster/
booster_*/
/booster_assets
/booster_deploy

# Optional ROS 2 Docker experiment (legacy/ros2_docker/): local workspaces and Dockerfile
/ros*/
/Dockerfile

# Local secrets (robot password etc.): never commit them; see docs/handover/
credentials*.md
!credentials.example.md
# The handover PDF contains the robot password; share it directly, not via git
docs/handover/*.pdf

# graphify knowledge graph output (rebuild locally with `graphify update .`)
graphify-out/
# Personal Claude Code settings (graphify hooks point to each person's own install)
.claude/settings.local.json
