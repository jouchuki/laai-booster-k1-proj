<!--
  Balance bike (no pedals) for the Booster K1. PLACEHOLDER GEOMETRY.

  Dimensions approximate a 12-inch kids' balance bike. Replace them with
  measurements of the real bike (see models/README.md) before training
  anything that should transfer to hardware.

  Frame: x forward, y left, z up. Origin on the ground under the rear axle.
  Only primitive geoms (capsule, cylinder, box): mesh contacts are slow and
  less reliable in GPU MuJoCo.
-->
<mujoco model="balance_bike">
  <compiler angle="degree" autolimits="true"/>
  <!-- State the gravity explicitly; the free root allows the whole bike to fall. -->
  <option gravity="0 0 -9.81"/>

  <default>
    <default class="bike">
      <geom rgba="0.15 0.45 0.8 1" friction="0.8 0.005 0.0001"/>
      <default class="wheel">
        <geom type="cylinder" size="0.15 0.02" rgba="0.1 0.1 0.1 1" friction="1.0 0.005 0.0001"/>
        <joint type="hinge" axis="0 1 0" damping="0.002"/>
      </default>
    </default>
  </default>

  <worldbody>
    <body name="frame" childclass="bike">
      <freejoint name="root"/>
      <!-- Main tube: rear axle to head tube -->
      <geom name="main_tube" type="capsule" size="0.02" fromto="0 0 0.15 0.50 0 0.50" mass="1.2"/>
      <!-- Seat post and saddle (seat height 0.40 m: TODO measure) -->
      <geom name="seat_post" type="capsule" size="0.015" fromto="0.12 0 0.24 0.12 0 0.38" mass="0.3"/>
      <geom name="saddle" type="box" size="0.09 0.06 0.015" pos="0.10 0 0.40" rgba="0.2 0.2 0.2 1" mass="0.3"/>
      <site name="seat" pos="0.10 0 0.415" size="0.01"/>

      <body name="rear_wheel" pos="0 0 0.15">
        <joint name="rear_wheel" class="wheel"/>
        <geom name="rear_wheel" class="wheel" zaxis="0 1 0" mass="0.6"/>
      </body>

      <!-- Steering: head angle 70 deg (axis tilted 20 deg back from vertical),
           giving about 5.5 cm of trail. TODO measure head angle and fork offset. -->
      <body name="fork" pos="0.50 0 0.50">
        <joint name="steer" type="hinge" axis="-0.342 0 0.940" range="-45 45" damping="0.05" armature="0.001"/>
        <geom name="fork_tube" type="capsule" size="0.015" fromto="0 0 0 0.127 0 -0.35" mass="0.4"/>
        <geom name="stem" type="capsule" size="0.015" fromto="0 0 0 -0.04 0 0.11" mass="0.1"/>
        <geom name="handlebar" type="capsule" size="0.012" fromto="-0.04 -0.18 0.11 -0.04 0.18 0.11" mass="0.2"/>
        <site name="left_grip" pos="-0.04 0.16 0.11" size="0.015" rgba="1 0.5 0 1"/>
        <site name="right_grip" pos="-0.04 -0.16 0.11" size="0.015" rgba="1 0.5 0 1"/>

        <body name="front_wheel" pos="0.127 0 -0.35">
          <joint name="front_wheel" class="wheel"/>
          <geom name="front_wheel" class="wheel" zaxis="0 1 0" mass="0.6"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
